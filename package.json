{
  "name": "factory",
  "version": "0.1.0",
  "private": true,
  "description": "Software Factory: deterministic pipeline from task to reviewed PR",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.34.6",
  "bin": {
    "factory": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "profiles",
    "roles",
    "standards",
    "templates",
    "README.md",
    "SPEC.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "schemas": "tsc -p tsconfig.build.json && node scripts/gen-schemas.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "eslint": "^10.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
