{
  "$id": "https://github.com/spignotti/factory/schemas/result.schema.json",
  "title": "factory result.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "type": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "feature",
            "bug",
            "chore"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "lane": {
      "type": "string",
      "enum": [
        "standard",
        "fast"
      ]
    },
    "result": {
      "type": "string",
      "enum": [
        "done",
        "needs_human",
        "needs_input",
        "failed",
        "base_red",
        "locked",
        "abandoned"
      ]
    },
    "risk": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "risk_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "merge_policy": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "auto",
            "bot_review",
            "human_review"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "pr": {
      "type": [
        "string",
        "null"
      ]
    },
    "rounds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "minutes": {
      "type": "number",
      "minimum": 0
    },
    "cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "reason": {
      "type": "string"
    },
    "outcome": {
      "type": "object",
      "properties": {
        "ticket": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "attempts": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "delivered_pr": {
          "type": [
            "string",
            "null"
          ]
        },
        "merged": {
          "type": "string",
          "enum": [
            "no",
            "confirmed",
            "unknown"
          ]
        },
        "ended_without_merge": {
          "type": "boolean"
        },
        "open_decision": {
          "type": "boolean"
        }
      },
      "required": [
        "ticket",
        "attempts",
        "delivered_pr",
        "merged",
        "ended_without_merge",
        "open_decision"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "factory_version": {
          "type": "string"
        },
        "factory_commit": {
          "type": "string"
        },
        "prompt_revision": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        },
        "config_fingerprint": {
          "type": "string"
        },
        "base": {
          "type": [
            "string",
            "null"
          ]
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "factory_version",
        "factory_commit",
        "prompt_revision",
        "model",
        "effort",
        "config_fingerprint",
        "base",
        "head",
        "checks"
      ],
      "additionalProperties": false
    },
    "skipped_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counted_lines": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "excluded_test_lines": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "worktree": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_dir": {
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "repo",
    "task",
    "type",
    "lane",
    "result",
    "risk",
    "merge_policy",
    "pr",
    "rounds",
    "minutes",
    "cost_usd",
    "reason",
    "branch",
    "worktree",
    "run_dir"
  ],
  "additionalProperties": false
}
