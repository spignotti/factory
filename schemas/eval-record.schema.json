{
  "$id": "https://github.com/spignotti/factory/schemas/eval-record.schema.json",
  "title": "eval result line (evals/results/<date>.jsonl)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "started_at": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "repeat": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "type": "string",
      "enum": [
        "done",
        "needs_human",
        "needs_input",
        "failed",
        "base_red",
        "locked",
        "error"
      ]
    },
    "reason": {
      "type": "string"
    },
    "hidden_pass": {
      "type": "boolean"
    },
    "hidden_output": {
      "type": "string"
    },
    "rounds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "gate_failures": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bug_findings": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "real_findings": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tokens_in": {
      "type": "number",
      "minimum": 0
    },
    "tokens_out": {
      "type": "number",
      "minimum": 0
    },
    "cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "usage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "calls": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "errors": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "tokens_in": {
            "type": "number"
          },
          "tokens_out": {
            "type": "number"
          },
          "cost_usd": {
            "type": "number"
          }
        },
        "required": [
          "role",
          "model",
          "calls",
          "errors",
          "tokens_in",
          "tokens_out",
          "cost_usd"
        ],
        "additionalProperties": false
      }
    },
    "wall_s": {
      "type": "number",
      "minimum": 0
    },
    "timed_out": {
      "type": "boolean"
    }
  },
  "required": [
    "version",
    "started_at",
    "task",
    "profile",
    "repeat",
    "run_id",
    "result",
    "reason",
    "hidden_pass",
    "hidden_output",
    "rounds",
    "gate_failures",
    "bug_findings",
    "real_findings",
    "tokens_in",
    "tokens_out",
    "cost_usd",
    "usage",
    "wall_s",
    "timed_out"
  ],
  "additionalProperties": false
}
