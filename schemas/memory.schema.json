{
  "$id": "https://github.com/spignotti/factory/schemas/memory.schema.json",
  "title": "findings memory ($FACTORY_HOME/memory/<repo>/findings.json)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "repo": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "reviewer": {
            "type": "string"
          },
          "checkable": {
            "type": "string",
            "enum": [
              "lint",
              "test",
              "script",
              "no"
            ]
          },
          "check_sketch": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "first_seen": {
            "type": "string"
          },
          "last_seen": {
            "type": "string"
          },
          "runs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "proposed",
              "resolved"
            ]
          },
          "ref": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "text",
          "reviewer",
          "checkable",
          "check_sketch",
          "count",
          "first_seen",
          "last_seen",
          "runs",
          "status",
          "ref"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "repo",
    "entries"
  ],
  "additionalProperties": false
}
