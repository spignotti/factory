{
  "$id": "https://github.com/spignotti/factory/schemas/eval-task.schema.json",
  "title": "eval task (evals/tasks/<id>.yaml)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "plan_effort": {
      "default": "medium",
      "type": "string",
      "enum": [
        "none",
        "medium",
        "high"
      ]
    },
    "hidden": {
      "type": "object",
      "properties": {
        "from_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "paths": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "check": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "from_commit",
        "paths",
        "check"
      ]
    },
    "timeout_min": {
      "default": 30,
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "repo_config": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "exclude": {
      "default": [
        ".venv/",
        "node_modules/"
      ],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "repo",
    "base",
    "task",
    "hidden",
    "license",
    "source"
  ],
  "additionalProperties": false
}
